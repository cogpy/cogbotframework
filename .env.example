# Microsoft Bot Framework Configuration
MicrosoftAppId=your_app_id_here
MicrosoftAppPassword=your_app_password_here
ChannelService=
BotOpenIdMetadata=

# OpenCog Configuration
OPENCOG_HOST=localhost
OPENCOG_PORT=17001
ATOMSPACE_SIZE=1000000
COGSERVER_PATH=/usr/local/bin/cogserver

# Server Configuration
PORT=3978
LOG_LEVEL=info

# Cognitive Processing Configuration
COGNITIVE_PROCESSING_TIMEOUT=10000
MAX_CONCURRENT_SESSIONS=100
AUTOGENESIS_ENABLED=true
LEARNING_RATE=0.01
SYNERGY_THRESHOLD=0.8
EMERGENT_BEHAVIOR_DETECTION=true

# Memory Configuration
MEMORY_CAPACITY=10000
ATTENTION_WINDOW=50
CONCEPT_LEARNING_THRESHOLD=0.6
PATTERN_MATCHING_DEPTH=5
EMOTIONAL_MODELING=true

# Performance Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100